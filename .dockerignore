# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Cargo / local build outputs ──────────────────────────────────────────────
# The fuzz builds run INSIDE the image; a host-side target/ would only bloat the
# context (rust-lightning's .gitignore already lists these, but the build context
# is not filtered by .gitignore).
target/
**/target/
hfuzz_target/
hfuzz_workspace/
**/*.rs.bk

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
.idea
